<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stride_widget_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/stride_widget_footer_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stride_widget_border" />

    <TextView
        android:id="@+id/stride_widget_footer_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/stride_widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
